<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_claim_document_list" model="ir.ui.view">
        <field name="name">insurance.claim.document.list</field>
        <field name="model">insurance.claim.document</field>
        <field name="arch" type="xml">
            <list string="Documents" editable="bottom">
                <field name="sequence" widget="handle"/>
                <field name="name"/>
                <field name="is_required"/>
                <field name="is_received"/>
                <field name="received_date"/>
                <field name="attachment_id" widget="many2one_binary_attachment"/>
                <field name="notes" optional="hide"/>
            </list>
        </field>
    </record>

    <record id="view_claim_document_form" model="ir.ui.view">
        <field name="name">insurance.claim.document.form</field>
        <field name="model">insurance.claim.document</field>
        <field name="arch" type="xml">
            <form string="Claim Document">
                <sheet>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="claim_id"/>
                            <field name="sequence"/>
                        </group>
                        <group>
                            <field name="is_required"/>
                            <field name="is_received"/>
                            <field name="received_date"/>
                        </group>
                    </group>
                    <group string="File">
                        <field name="attachment_id" widget="many2one_binary_attachment"/>
                    </group>
                    <group string="Guidance">
                        <field name="description" nolabel="1"/>
                    </group>
                    <group string="Notes">
                        <field name="notes" nolabel="1"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_claim_document_search" model="ir.ui.view">
        <field name="name">insurance.claim.document.search</field>
        <field name="model">insurance.claim.document</field>
        <field name="arch" type="xml">
            <search string="Documents">
                <field name="name"/>
                <field name="claim_id"/>
                <filter name="filter_outstanding" string="Outstanding" domain="[('is_required','=',True),('is_received','=',False)]"/>
                <filter name="filter_received" string="Received" domain="[('is_received','=',True)]"/>
                <group>
                    <filter name="group_claim" string="Claim" context="{'group_by':'claim_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_claim_document" model="ir.actions.act_window">
        <field name="name">Claim Documents</field>
        <field name="res_model">insurance.claim.document</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">No claim documents yet</p>
            <p>Checklist lines are created automatically when a claim is created.</p>
        </field>
    </record>
</odoo>
