<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_claim_provider_list" model="ir.ui.view">
        <field name="name">insurance.claim.service.provider.list</field>
        <field name="model">insurance.claim.service.provider</field>
        <field name="arch" type="xml">
            <list string="Service Providers" editable="bottom">
                <field name="partner_id"/>
                <field name="provider_type"/>
                <field name="appointment_date"/>
                <field name="report_received_date"/>
                <field name="active" optional="hide"/>
            </list>
        </field>
    </record>

    <record id="view_claim_provider_form" model="ir.ui.view">
        <field name="name">insurance.claim.service.provider.form</field>
        <field name="model">insurance.claim.service.provider</field>
        <field name="arch" type="xml">
            <form string="Service Provider">
                <sheet>
                    <group>
                        <group string="Provider">
                            <field name="partner_id"/>
                            <field name="provider_type"/>
                            <field name="claim_id"/>
                            <field name="active"/>
                        </group>
                        <group string="Engagement">
                            <field name="appointment_date"/>
                            <field name="report_received_date"/>
                        </group>
                    </group>
                    <group string="Instructions Issued">
                        <field name="instructions" nolabel="1" placeholder="Scope of the assessment, access arrangements, documents to be produced."/>
                    </group>
                    <group string="Notes">
                        <field name="notes" nolabel="1"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_claim_provider" model="ir.actions.act_window">
        <field name="name">Service Providers</field>
        <field name="res_model">insurance.claim.service.provider</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">No providers engaged</p>
            <p>Track assessors, adjusters, garages and other third parties appointed on a claim.</p>
        </field>
    </record>
</odoo>
