<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!--
        Claims lens layered onto the finance module's policy form.
        The form is inherited, never redefined: the finance module stays the
        single owner of the policy record.
    -->
    <record id="view_insurance_policy_form_claims" model="ir.ui.view">
        <field name="name">insurance.policy.form.claims</field>
        <field name="model">insurance.policy</field>
        <field name="inherit_id" ref="insurance_broker_finance.view_insurance_policy_form"/>
        <field name="arch" type="xml">
            <div name="button_box" position="inside">
                <button name="action_view_claims" type="object" class="oe_stat_button" icon="fa-briefcase" groups="insurance_broker_claims.group_claims_user">
                    <field name="claim_count" widget="statinfo" string="Claims"/>
                </button>
                <button name="action_new_claim" type="object" class="oe_stat_button" icon="fa-plus" groups="insurance_broker_claims.group_claims_user">
                    <div class="o_stat_info text-end">
                        <span class="o_stat_text">Notify Loss</span>
                        <span class="o_stat_value">New Claim</span>
                    </div>
                </button>
            </div>
            <xpath expr="//notebook" position="inside">
                <page string="Claims Experience" name="insurance_claims">
                    <div class="alert alert-warning" role="alert" invisible="not open_claim_count">
                        This policy has <field name="open_claim_count" readonly="1" class="text-danger"/> open claim(s). It cannot be cancelled until they are closed.
                    </div>
                    <div class="alert alert-info" role="alert">
                        Loss ratio divides total incurred claims by <strong>earned</strong> premium, pro-rated by the elapsed share of the cover period. A mid-term loss is not measured against premium that has not yet been earned.
                    </div>
                    <group>
                        <group>
                            <field name="earned_premium" widget="monetary"/>
                            <field name="claims_incurred_total" widget="monetary"/>
                        </group>
                        <group>
                            <field name="loss_ratio" widget="percentage_points"/>
                            <field name="loss_ratio_band" widget="badge" decoration-success="loss_ratio_band == 'low'" decoration-warning="loss_ratio_band == 'moderate'" decoration-danger="loss_ratio_band == 'adverse'"/>
                            <field name="open_claim_count"/>
                        </group>
                    </group>
                    <field name="claim_ids" context="{'default_policy_id': id}">
                        <list string="Claims">
                            <field name="name"/>
                            <field name="stage_id" widget="badge"/>
                            <field name="date_of_loss"/>
                            <field name="insurer_claim_ref" optional="hide"/>
                            <field name="estimated_amount" widget="monetary" optional="show"/>
                            <field name="assessed_amount" widget="monetary" optional="hide"/>
                            <field name="excess_amount" widget="monetary" optional="hide"/>
                            <field name="settled_amount" widget="monetary" optional="show"/>
                            <field name="incurred_amount" widget="monetary" sum="Incurred"/>
                            <field name="is_sla_breached" widget="boolean_toggle" optional="hide"/>
                        </list>
                    </field>
                </page>
            </xpath>
        </field>
    </record>
</odoo>
