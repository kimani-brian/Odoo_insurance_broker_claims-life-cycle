<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_claim_doc_template_list" model="ir.ui.view">
        <field name="name">insurance.claim.document.template.list</field>
        <field name="model">insurance.claim.document.template</field>
        <field name="arch" type="xml">
            <list string="Document Templates" editable="bottom">
                <field name="sequence" widget="handle"/>
                <field name="name"/>
                <field name="insurance_class"/>
                <field name="is_required"/>
                <field name="description" optional="show"/>
                <field name="active" optional="hide"/>
            </list>
        </field>
    </record>

    <record id="view_claim_doc_template_form" model="ir.ui.view">
        <field name="name">insurance.claim.document.template.form</field>
        <field name="model">insurance.claim.document.template</field>
        <field name="arch" type="xml">
            <form string="Document Template">
                <sheet>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="insurance_class"/>
                            <field name="sequence"/>
                        </group>
                        <group>
                            <field name="is_required"/>
                            <field name="active"/>
                        </group>
                    </group>
                    <group string="Broker Guidance">
                        <field name="description" nolabel="1" placeholder="What should the client be asked to provide?"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_claim_doc_template_search" model="ir.ui.view">
        <field name="name">insurance.claim.document.template.search</field>
        <field name="model">insurance.claim.document.template</field>
        <field name="arch" type="xml">
            <search string="Document Templates">
                <field name="name"/>
                <field name="insurance_class"/>
                <filter string="Required" name="filter_required" domain="[('is_required','=',True)]"/>
                <filter string="Archived" name="filter_archived" domain="[('active','=',False)]"/>
                <group>
                    <filter string="Business Class" name="group_class" context="{'group_by':'insurance_class'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_claim_doc_template" model="ir.actions.act_window">
        <field name="name">Document Checklists</field>
        <field name="res_model">insurance.claim.document.template</field>
        <field name="view_mode">list,form</field>
        <field name="context">{'search_default_filter_required': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Define your claim checklists</p>
            <p>Documents listed here are loaded onto new claims of the matching business class. Claims with no class preset fall back to 'General/Other'.</p>
        </field>
    </record>
</odoo>
